{
  "name": "big-building",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "agent:demo": "tsx integrations/42-agent/demo.ts",
    "agent:live": "tsx integrations/42-agent/demo.ts --live",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "agent:serve": "tsx integrations/42-agent/server.ts"
  },
  "dependencies": {
    "42-agent": "file:vendor/42-agent-0.1.0.tgz",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
